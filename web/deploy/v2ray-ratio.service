[Unit]
Description=Zarib Config web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ratio
Group=ratio
WorkingDirectory=/opt/v2ray-ratio/app
Environment=HOME=/opt/v2ray-ratio
Environment=XDG_CACHE_HOME=/opt/v2ray-ratio/.cache
Environment=RATIO_SAFE_FETCH=1
Environment=NO_COLOR=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/v2ray-ratio/bin/zarib-config serve --addr 127.0.0.1:8000 --static-dir /opt/v2ray-ratio/app/static
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/v2ray-ratio/.cache
MemoryMax=1G
TasksMax=256
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
